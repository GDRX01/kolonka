# Add / change these lines in backend/.env  (the rest comes from Laravel's .env.example)
APP_NAME=Kolonka
APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kolonka
DB_USERNAME=root
DB_PASSWORD=
# Password recovery e-mails.
# "log" = no mail server needed: the e-mail (with the reset link) is written to storage/logs/laravel.log.
# For real e-mails use SMTP (Mailtrap for testing, or Gmail/Brevo/etc. online).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@kolonka.test"
MAIL_FROM_NAME="Колонка"
# Address of the React site (used in the link inside the e-mail)
FRONTEND_URL=http://localhost:5173
